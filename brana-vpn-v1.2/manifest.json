{
  "manifest_version": 3,
  "name": "Brana VPN · 浏览器专属加速",
  "short_name": "Brana VPN",
  "version": "1.2.8",
  "description": "浏览器专属 VPN：全局按「节点 + ProxyIP」智能优选，连通性优先、自动容灾切换，延迟与速度实时最优。",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "nativeMessaging",
    "privacy",
    "notifications",
    "scripting",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Brana VPN",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "commands": {
    "toggle-vpn": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "开启 / 关闭 Brana VPN" },
    "next-ip": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "更换出口 IP（下一个 ProxyIP）" }
  },
  "web_accessible_resources": [{ "resources": ["shared/flags.woff2"], "matches": ["<all_urls>"] }]
}
